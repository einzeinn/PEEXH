APP_ENV=development
APP_NAME=peexh
LOG_LEVEL=INFO

# AssemblyAI
ASSEMBLYAI_API_KEY=

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Supabase / Database
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# PEEXH confidence policy
PEEXH_HIGH_CONFIDENCE_THRESHOLD=0.80
PEEXH_LOW_CONFIDENCE_THRESHOLD=0.45

# Feature flags
ENABLE_PERSONAL_MEMORY=true
ENABLE_TTS=true

# TTS
TTS_PROVIDER=browser
